# ==============================================================================
# Speed OCR Backend Environment Configuration
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/ocr

# Authentication & Security
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Speed limit in km/h for flagging speed violations
SPEED_LIMIT_KMH=60

# Media Storage Directory (relative or absolute path for screenshots, plates, and videos)
MEDIA_ROOT=./media

# Allowed CORS Origins (comma-separated list of frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5177,http://localhost:5178,http://127.0.0.1:5173,http://127.0.0.1:5178

# Redis Configuration (for WebSocket broadcast & real-time event streaming)
REDIS_HOST=localhost
REDIS_PORT=6379

# Development flag: set to 1 to bypass auth checks during local testing (0 for production)
SKIP_AUTH=0
