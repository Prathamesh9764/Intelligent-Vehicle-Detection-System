# ==============================================================================
# Speed OCR Frontend Environment Configuration
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Backend API base URL (FastAPI server)
VITE_API_BASE=http://localhost:8001

# Speed OCR Frontend URL
VITE_SPEED_OCR=http://localhost:5178/

# Theme configuration: 'dark' (night theme) or 'light' (day theme)
# Default is dark (night theme)
VITE_DEFAULT_THEME=dark
