# ==============================================================================
# Highway Detection Pipeline Environment Configuration
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Backend API endpoint for ingestion and auth
API_BASE=http://localhost:8001/
API_USERNAME=admin
API_PASSWORD=admin123

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:12345@localhost:5432/speed_ocr

# Redis Message Broker Configuration (for distributed workers and stream caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# WebSocket endpoint for camera stream feed
CAMERA_WS_URL=ws://127.0.0.1:8001/ws/camera

# ------------------------------------------------------------------------------
# Optional Pipeline & Hardware Settings (uncomment to override defaults)
# ------------------------------------------------------------------------------
# Inference hardware device: cpu | cuda:0 | gpu | mps
# INFERENCE_DEVICE=cpu

# YOLOv8 Model size: n (nano) | s (small) | m (medium) | l (large) | x (xlarge)
# YOLO_MODEL_SIZE=s

# Video input source: file path or RTSP stream URL (e.g. rtsp://user:pass@192.168.1.100:554/live)
# VIDEO_SOURCE=assets/videos/speed.mp4

# Distance in meters between Gate 0 and Gate 1 for speed calculation
# GATE_DISTANCE=15.0

# Detection confidence and IOU thresholds
# CONF=0.30
# IOU=0.45
